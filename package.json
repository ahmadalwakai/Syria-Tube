    "react-native": "0.86.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  }
}
